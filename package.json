{
  "name": "bento-ui-admin",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm format:check && pnpm design:lint && pnpm components:check && pnpm focus:check && pnpm lint && pnpm build",
    "components:check": "node scripts/check-component-coverage.mjs",
    "focus:check": "node scripts/check-focus-styles.mjs",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "design:lint": "designmd lint DESIGN.md",
    "design:css": "designmd export --format css-tailwind DESIGN.md > src/theme.css",
    "design:dtcg": "designmd export --format dtcg DESIGN.md > tokens.json",
    "design:build": "pnpm design:css && pnpm design:dtcg"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@google/design.md": "0.4.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
